# Use an official Ubuntu base image
FROM ubuntu:latest

# Set non-interactive mode to avoid prompts
ENV DEBIAN_FRONTEND=noninteractive

# Update package lists and install Python 3, pip, and other dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    gunicorn  # Corrected:  Now an installation instruction

# Create a virtual environment
RUN python3 -m venv /app/venv
ENV VIRTUAL_ENV=/app/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Activate the virtual environment
# CMD ["/bin/bash", "-c"]  # Important: ensure commands run inside the venv

# Upgrade pip inside the virtual environment
RUN pip install --upgrade pip

# Install Flask and gunicorn
RUN pip install flask gunicorn

# Set the working directory inside the container
WORKDIR /app

# Copy your Python code
COPY . .

# Install any other dependencies from requirements.txt if you have one
# RUN pip install -r requirements.txt

# Expose the port your Flask app will listen on
EXPOSE 5000

# Define the command to run when the container starts
# This will run the Flask app using Gunicorn
# CMD ["gunicorn", "--bind", "0.0.0.0:5000", "hello:app"] # Corrected CMD line
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "hello:app"]
