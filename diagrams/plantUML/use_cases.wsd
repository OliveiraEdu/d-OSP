@startuml
left to right direction
skinparam monochrome true

actor Researcher
actor Collaborator
actor "Data Consumer" as Consumer
actor "Funding Agency" as Funder

package "d-OSP Platform" {
    usecase "UC1: Enroll & Verify Identity" as UC1
    usecase "UC2: Register Project" as UC2
    usecase "UC3: Upload Data & Anchor Provenance" as UC3
    usecase "UC4: Search Metadata" as UC4
    usecase "UC5: Validate & Download File" as UC5
    usecase "UC6: Collaborate on Project" as UC6
    usecase "UC7: View Audit Trail" as UC7
    usecase "UC8: Access Archived Data" as UC8
}

Researcher --> UC1
Researcher --> UC2
Researcher --> UC3
Researcher --> UC5
Researcher --> UC6

Collaborator --> UC6

Consumer --> UC4
Consumer --> UC5
Consumer --> UC8

Funder --> UC7
@enduml
